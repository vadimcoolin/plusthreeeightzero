---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;

interface Props {
  title: string;
  lang: string;
}

const { title, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline>
      (function() {
        var themes = [
          { primary: '#EBEAE5', secondary: '#28282A', muted: '#81807F' },
          { primary: '#28282A', secondary: '#EBEAE5', muted: '#81807F' },
          { primary: '#E2E417', secondary: '#ED008C', muted: '#F39393' },
          { primary: '#EBEAE5', secondary: '#28282A', muted: '#81807F' },
          { primary: '#28282A', secondary: '#EBEAE5', muted: '#81807F' },
          { primary: '#FEE9E8', secondary: '#1D2795', muted: '#696DB9' },
        ];
        var stored = localStorage.getItem('themeIndex');
        var idx = stored !== null ? parseInt(stored, 10) : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 1 : 0);
        var t = themes[idx];
        var r = document.documentElement;
        r.style.setProperty('--color-primary', t.primary);
        r.style.setProperty('--color-secondary', t.secondary);
        r.style.setProperty('--color-muted', t.muted);
        document.body.style.backgroundColor = t.primary;
        document.body.style.color = t.secondary;
      })();
    </script>
    <slot />
  </body>
</html>
