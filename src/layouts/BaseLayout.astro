---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const siteUrl = 'https://coolin.cc/plusthreeeightzero';

interface Props {
  title: string;
  description: string;
  lang: string;
  pathLang?: string;
}

const { title, description, lang, pathLang } = Astro.props;
const langSlug = pathLang || lang;
const ogImage = `${siteUrl}/ogimage_${langSlug}.png`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${siteUrl}/${langSlug}/`} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <script is:inline>
      (function() {
        var themes = [
          { primary: '#EBEAE5', secondaryBg: '#FFFFFF', secondary: '#28282A', muted: '#81807F' },
          { primary: '#28282A', secondaryBg: '#0F0F11', secondary: '#EBEAE5', muted: '#81807F' },
          { primary: '#E2E417', secondaryBg: '#FEFFA8', secondary: '#ED008C', muted: '#F39393' },
          { primary: '#EBEAE5', secondaryBg: '#FFFFFF', secondary: '#28282A', muted: '#81807F' },
          { primary: '#28282A', secondaryBg: '#0F0F11', secondary: '#EBEAE5', muted: '#81807F' },
          { primary: '#FFDED2', secondaryBg: '#FEE9E8', secondary: '#1D2795', muted: '#696DB9' },
          { primary: '#EBEAE5', secondaryBg: '#FFFFFF', secondary: '#28282A', muted: '#81807F' },
          { primary: '#28282A', secondaryBg: '#0F0F11', secondary: '#EBEAE5', muted: '#81807F' },
          { primary: '#C3DBCB', secondaryBg: '#F1FAE5', secondary: '#A33E19', muted: '#FF8000' },
        ];
        var stored = localStorage.getItem('themeIndex');
        var idx = stored !== null ? parseInt(stored, 10) : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 1 : 0);
        var t = themes[idx];
        var r = document.documentElement;
        r.style.setProperty('--color-primary', t.primary);
        r.style.setProperty('--color-secondary-bg', t.secondaryBg);
        r.style.setProperty('--color-secondary', t.secondary);
        r.style.setProperty('--color-muted', t.muted);
        document.body.style.backgroundColor = t.primary;
        document.body.style.color = t.secondary;
      })();
    </script>
    <slot />
    <script>
      import Lenis from 'lenis';
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        touchMultiplier: 2,
      });
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
    </script>
  </body>
</html>
