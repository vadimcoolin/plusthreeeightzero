---
interface Props {
  text: string;
  buttonText: string;
}
const { text, buttonText } = Astro.props;
---
<div class="about-cta mobile-gap-before">
  <div class="cta-inner">
    <p class="font-medium" style={`font-size: var(--font-size-service-number); color: var(--color-secondary); line-height: 1.3`}>{text}</p>
    <a href="mailto:ivanrogovchenko@gmail.com" class="cta-button">
      {buttonText}
    </a>
  </div>
</div>

<style>
  .about-cta {
    width: 100%;
    margin-top: var(--spacing-section-gap);
    padding: 0 var(--spacing-page) var(--spacing-end);
  }
  .cta-inner {
    margin-left: 50%;
  }
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-button);
    font-weight: 500;
    height: var(--height-button);
    padding: 0 var(--padding-button-x);
    border-radius: 9999px;
    background: var(--color-secondary);
    color: var(--color-primary);
    border: none;
    cursor: pointer;
    transition: background-color 0.3s;
    text-decoration: none;
    margin-top: 2em;
  }
  .cta-button:hover {
    background: var(--color-muted);
  }
  @media (max-width: 767px) {
    .cta-inner {
      margin-left: 0;
    }
    .cta-button {
      margin-top: 1em;
    }
  }
</style>
