---
interface Props {
  text: string;
  buttonText: string;
}
const { text, buttonText } = Astro.props;
---
<div class="services-cta" style={`margin-top: var(--spacing-section-gap)`}>
  <div class="md:ml-[50%]">
    <p class="font-medium" style={`font-size: var(--font-size-service-number); color: var(--color-secondary); line-height: 1.3`}>{text}</p>
    <a href="mailto:ivanrogovchenko@gmail.com" class="inline-flex items-center justify-center font-medium mt-8 rounded-full transition-colors" style={`font-size: var(--font-size-button); height: var(--height-button); padding: 0 var(--padding-button-x); background: var(--color-secondary); color: var(--color-primary); border: none; cursor: pointer`} onmouseover="this.style.background='var(--color-muted)'" onmouseout="this.style.background='var(--color-secondary)'">
      {buttonText}
    </a>
  </div>
</div>
