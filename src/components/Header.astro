---
const base = import.meta.env.BASE_URL;
const lang = Astro.url.pathname.includes('/ua/') ? 'ua' : 'en';

const links = lang === 'ua'
  ? [
      { href: '#index', label: 'Головна' },
      { href: '#services', label: 'Послуги' },
      { href: '#about', label: 'Про нас' },
      { href: '#works', label: 'Проєкти' },
      { href: '#contacts', label: 'Контакти' },
    ]
  : [
      { href: '#index', label: 'Index' },
      { href: '#services', label: 'Services' },
      { href: '#about', label: 'About' },
      { href: '#works', label: 'Works' },
      { href: '#contacts', label: 'Contacts' },
    ];

const switchLang = lang === 'ua' ? 'EN' : 'UA';
const switchUrl = lang === 'ua' ? `${base}en/` : `${base}ua/`;
---

<header class="absolute top-0 left-0 w-full z-50">
  <nav class="flex items-center justify-between" style={`padding: var(--spacing-page) var(--spacing-page)`}>
    <a href={`${base}${lang}/`}>
      <img src={`${base}logo_main.svg`} alt="Plusthreeeightzero" style="height: var(--spacing-logo)" />
    </a>
    <div class="flex items-center" style={`gap: var(--spacing-header-gap)`}>
      <ul class="flex items-center" style={`gap: var(--spacing-menu-gap)`}>
        {links.map((link) => (
          <li>
            <a href={link.href} class="flex items-center font-medium hover:opacity-60 transition-opacity" style={`font-size: var(--font-size-menu)`}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={switchUrl} class="flex items-center font-medium" style={`gap: var(--spacing-switcher-gap); font-size: var(--font-size-menu)`}>
        <span class={lang === 'en' ? 'text-[var(--color-text)]' : 'text-[#81807F]'}>EN</span>
        <span class="text-[#81807F]">/</span>
        <span class={lang === 'ua' ? 'text-[var(--color-text)]' : 'text-[#81807F]'}>UA</span>
      </a>
      <button class="hover:opacity-60 transition-opacity" aria-label="Toggle theme">
        <img src={`${base}plus.svg`} alt="+" style={`width: var(--spacing-logo); height: var(--spacing-logo)`} />
      </button>
    </div>
  </nav>
</header>
