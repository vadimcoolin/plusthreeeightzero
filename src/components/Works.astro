---
import WorksItem from './WorksItem.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Project {
  image: string;
  title: string;
  tags: string[];
  link: string;
}
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---
<section id="works" class="w-full" style={`padding: var(--spacing-block-gap) var(--spacing-page) var(--spacing-block-gap)`}>
  <div class="works-header">
    <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2); color: var(--color-secondary)`}>
      Selected projects
    </h2>
    <Breadcrumbs items={[
      { label: 'Index', href: '#index' },
      { label: 'Works' }
    ]} />
  </div>
  <div class="works-list">
    {projects.map((project) => (
      <WorksItem
        image={project.image}
        title={project.title}
        tags={project.tags}
        link={project.link}
      />
    ))}
  </div>
</section>

<style>
  .works-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: calc(var(--spacing-section-gap) / 4);
  }
  .works-list {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing-section-gap) / 2);
  }
  @media (max-width: 767px) {
    .works-header {
      flex-direction: column;
      gap: var(--spacing-page);
    }
    .works-header :global(h2) {
      order: 1;
    }
    .works-header :global(nav) {
      order: -1;
    }
  }
</style>
