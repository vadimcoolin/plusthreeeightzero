---
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---
<div class="about-stats" style={`margin-top: var(--spacing-block-gap)`}>
  {stats.map((stat, i) => (
    <div class="stat-row">
      <div class="grid grid-cols-1 md:grid-cols-4 items-center" style={`gap: var(--spacing-page)`}>
        <div class="md:col-span-1 flex justify-start md:justify-end" style={`padding-right: var(--spacing-block-gap)`}>
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="11" y1="0" x2="11" y2="22" stroke="currentColor" stroke-width="1"/>
            <line x1="0" y1="11" x2="22" y2="11" stroke="currentColor" stroke-width="1"/>
          </svg>
        </div>
        <div class="md:col-span-3">
          <div class="font-semibold leading-[0.95]" style={`font-size: var(--font-size-title); color: var(--color-secondary)`}>{stat.value}</div>
          <div class="font-normal" style={`font-size: var(--font-size-subtitle); color: var(--color-secondary); margin-top: 0.2em`}>{stat.label}</div>
        </div>
      </div>
    </div>
  ))}
</div>
<style>
  .stat-row + .stat-row {
    margin-top: var(--spacing-block-gap);
  }
</style>
