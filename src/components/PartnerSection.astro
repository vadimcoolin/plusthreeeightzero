---
interface Props {
  textLeft: string;
  itemsRight: string[];
}
const { textLeft, itemsRight } = Astro.props;
---
<section class="w-full section-gap-before">
  <div class="mobile-gap-before">
    <h2 class="partner-left font-medium leading-[1.1]" style={`font-size: var(--font-size-h2)`}>
      <span style={`color: var(--color-secondary)`}>{textLeft}</span>
    </h2>
    <div class="partner-spacer"></div>
    <div class="partner-right">
      {itemsRight.map((item) => (
        <p class="partner-item">{item}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-left {
    width: 66.666%;
  }
  .partner-spacer {
    height: 24px;
  }
  .partner-right {
    margin-left: 50%;
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .partner-item {
    font-size: var(--font-size-service-list);
    font-weight: 400;
    color: var(--color-secondary);
    line-height: 1.3;
  }
  @media (max-width: 767px) {
    .partner-left {
      width: 100%;
    }
    .partner-spacer {
      height: 1.5em;
    }
    .partner-right {
      margin-left: 0;
      gap: 1em;
    }
  }
</style>
