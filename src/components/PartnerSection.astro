---
interface Props {
  textLeft: string;
  itemsRight: string[];
}
const { textLeft, itemsRight } = Astro.props;
---
<section class="w-full section-gap-before">
  <div class="partner-grid mobile-gap-before">
    <div class="partner-left">
      <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2)`}>
        <span style={`color: var(--color-secondary)`}>{textLeft}</span>
      </h2>
    </div>
    <div class="partner-right">
      {itemsRight.map((item) => (
        <p class="partner-item">{item}</p>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
  }
  .partner-left {
    grid-column: 1;
    grid-row: 1;
  }
  .partner-right {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    grid-column: 2;
    grid-row: 2;
  }
  .partner-item {
    font-size: var(--font-size-service-list);
    font-weight: 400;
    color: var(--color-secondary);
    line-height: 1.3;
  }
  @media (max-width: 767px) {
    .partner-grid {
      grid-template-columns: 1fr;
    }
    .partner-right {
      grid-column: 1;
      padding-top: 1.5em;
      gap: 1em;
    }
  }
</style>
