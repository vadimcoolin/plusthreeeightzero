---
interface Props {
  image: string;
  title: string;
  tags: string[];
  link: string;
}
const { image, title, tags, link } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="works-item">
  <a href={link} target="_blank" rel="noopener noreferrer" class="works-link">
    <div class="works-image-wrap">
      <img src={`${base}${image}`} alt={title} class="works-image" loading="lazy" />
    </div>
    <h3 class="works-title">{title}</h3>
  </a>
  <div class="works-tags">
    {tags.map((tag) => (
      <span class="works-tag">{tag}</span>
    ))}
  </div>
</div>

<style>
  .works-item {
    display: block;
  }
  .works-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .works-image-wrap {
    overflow: hidden;
  }
  .works-image {
    width: 100%;
    object-fit: cover;
    aspect-ratio: 16/9;
    transition: transform 0.3s;
  }
  .works-link:hover .works-image {
    transform: scale(1.08);
  }
  .works-title {
    font-size: var(--font-size-service-number);
    font-weight: 500;
    color: var(--color-secondary);
    margin-top: 0.25em;
    line-height: 1.3;
    transition: opacity 0.3s;
  }
  .works-link:hover .works-title {
    opacity: 0.6;
  }
  .works-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin-top: 0.1875em;
  }
  .works-tag {
    font-size: var(--font-size-service-list);
    font-weight: 400;
    color: var(--color-secondary);
  }
  @media (max-width: 767px) {
    .works-title {
      margin-top: 0.75em;
    }
    .works-tags {
      gap: 0.25em;
      margin-top: 0.5em;
    }
  }
</style>
