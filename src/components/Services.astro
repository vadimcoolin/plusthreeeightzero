---
import ServicesList from './ServicesList.astro';
import ServicesCta from './ServicesCta.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  breadcrumbs: { label: string; href?: string }[];
  textFirst: string;
  textSecond: string;
  services: { title: string; items: string[]; number: string }[];
  ctaText: string;
  ctaButtonText: string;
}
const { breadcrumbs, textFirst, textSecond, services, ctaText, ctaButtonText } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section id="services" class="w-full" style={`padding: var(--spacing-block-gap) var(--spacing-page) var(--spacing-section-gap)`}>
  <div class="grid grid-cols-1 md:grid-cols-4" style={`gap: var(--spacing-page)`}>
    <div class="md:col-span-1 flex items-start">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="md:col-span-3 mobile-gap-before">
      <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2); text-indent: 3em`}>
        <span style={`color: var(--color-secondary)`}>{textFirst} </span><span style={`color: var(--color-muted)`}>{textSecond}</span>
      </h2>
    </div>
  </div>
  <ServicesList services={services} />
  <ServicesCta text={ctaText} buttonText={ctaButtonText} />
</section>
