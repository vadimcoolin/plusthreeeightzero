---
import ServicesList from './ServicesList.astro';
import ServicesCta from './ServicesCta.astro';

interface Props {
  breadcrumbs: { label: string; href?: string }[];
  textFirst: string;
  textSecond: string;
  services: { title: string; items: string[]; number: string }[];
  ctaText: string;
  ctaButtonText: string;
}
const { breadcrumbs, textFirst, textSecond, services, ctaText, ctaButtonText } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section id="services" class="w-full" style={`padding: var(--spacing-block-gap) var(--spacing-page) var(--spacing-section-gap)`}>
  <div class="grid grid-cols-1 md:grid-cols-4" style={`gap: var(--spacing-page)`}>
    <div class="md:col-span-1 flex items-start">
      <nav class="flex items-center" style={`font-size: var(--font-size-breadcrumbs); font-weight: 400`}>
        <svg width="22" height="22" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" style="flex-shrink: 0">
          <path d="M30 12.2919H17.7089V0H12.2919V12.2919H0V17.7089H12.2919V30H17.7089V17.7089H30V12.2919Z" fill="currentColor"/>
        </svg>
        {breadcrumbs.map((crumb, i) => (
          <span class="flex items-center" style={i === 0 ? 'margin-left: 24px' : ''}>
            {i > 0 && <span style={`color: var(--color-muted); padding: 0 12px`}>/</span>}
            {crumb.href ? (
              <a href={crumb.href} style={`color: var(--color-muted)`} class="hover:text-[var(--color-secondary)] transition-colors">{crumb.label}</a>
            ) : (
              <span style={`color: var(--color-secondary); text-decoration: underline; text-underline-offset: 0.2em`}>{crumb.label}</span>
            )}
          </span>
        ))}
      </nav>
    </div>
    <div class="md:col-span-3 mobile-gap-before">
      <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2); text-indent: 3em`}>
        <span style={`color: var(--color-secondary)`}>{textFirst} </span><span style={`color: var(--color-muted)`}>{textSecond}</span>
      </h2>
    </div>
  </div>
  <ServicesList services={services} />
  <ServicesCta text={ctaText} buttonText={ctaButtonText} />
</section>
