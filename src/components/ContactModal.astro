---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
const lang = Astro.url.pathname.includes('/ua/') ? 'ua' : 'en';

const labels = lang === 'ua'
  ? { name: 'Ім\'я*', email: 'Email*', phone: 'Телефон', message: 'Повідомлення*', send: 'Надіслати', close: 'ЗАКРИТИ', title: 'ДАВАЙТЕ ПОГОВОРИМО!', namePh: 'Іван Петренко', emailPh: 'ivan@gmail.com', phonePh: '+380 XX XXX XXXX', messagePh: 'Розкажіть нам про ваш проєкт...' }
  : { name: 'Name*', email: 'Email*', phone: 'Phone', message: 'Message*', send: 'Send', close: 'CLOSE', title: 'LETS TALK!', namePh: 'Lorem Ipsum', emailPh: 'lorem.ipsum@gmail.com', phonePh: '+XXX XX XXXXXXX', messagePh: 'Tell us about your project...' };
---
<div class="contact-modal hidden js-contact-modal" role="dialog" aria-modal="true">
  <div class="contact-modal-inner">
    <header class="contact-modal-header">
      <Logo style="height: var(--spacing-logo); width: auto; color: var(--color-secondary)" />
      <div class="contact-modal-header-right">
        <button class="contact-modal-close js-contact-close font-medium" style={`font-size: var(--font-size-menu)`}>
          {labels.close}
        </button>
      </div>
    </header>
    <div class="contact-modal-content">
      <h1 class="contact-modal-title uppercase leading-[0.95] font-semibold" style={`font-size: var(--font-size-title)`}>
        {labels.title}
      </h1>
      <form class="contact-modal-form" id="contact-form">
        <div class="contact-modal-field">
          <label class="contact-modal-label">{labels.name}</label>
          <input type="text" name="name" class="contact-modal-input" placeholder={labels.namePh} required />
        </div>
        <div class="contact-modal-field">
          <label class="contact-modal-label">{labels.email}</label>
          <input type="email" name="email" class="contact-modal-input" placeholder={labels.emailPh} required />
        </div>
        <div class="contact-modal-field">
          <label class="contact-modal-label">{labels.phone}</label>
          <input type="tel" name="phone" class="contact-modal-input" placeholder={labels.phonePh} />
        </div>
        <div class="contact-modal-field">
          <label class="contact-modal-label">{labels.message}</label>
          <textarea name="message" class="contact-modal-input contact-modal-textarea" placeholder={labels.messagePh} required></textarea>
        </div>
        <div class="contact-modal-submit">
          <button type="submit" class="contact-modal-send">
            {labels.send}
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  .contact-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--color-primary);
    color: var(--color-secondary);
    overflow: hidden;
  }
  .contact-modal-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .contact-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-page);
  }
  .contact-modal-header-right {
    display: flex;
    align-items: center;
  }
  .contact-modal-close {
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s;
  }
  .contact-modal-close:hover {
    opacity: 0.6;
  }
  .contact-modal-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0 var(--spacing-page) var(--spacing-page);
  }
  .contact-modal-title {
    margin: 0;
  }
  .contact-modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }
  .contact-modal-field {
    display: grid;
    grid-template-columns: 120px 1fr;
    align-items: start;
    gap: var(--spacing-page);
  }
  .contact-modal-label {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 18px;
    color: var(--color-secondary);
  }
  .contact-modal-input {
    background: none;
    border: none !important;
    border-block: none !important;
    border-inline: none !important;
    box-shadow: none !important;
    color: var(--color-secondary);
    font-family: 'Inter', sans-serif;
    font-size: var(--font-size-h3);
    line-height: 1;
    padding: 0;
    margin: 0;
    outline: none;
  }
  .contact-modal-input::placeholder {
    color: var(--color-muted);
    opacity: 1;
    font-size: var(--font-size-h3);
    line-height: 1;
  }
  .contact-modal-input:focus {
    color: var(--color-secondary);
  }
  .contact-modal-input:invalid:not(:placeholder-shown) {
    color: #e53e3e;
  }
  .contact-modal-input:invalid:not(:placeholder-shown)::placeholder {
    color: #e53e3e;
  }
  .contact-modal-textarea {
    resize: none;
    overflow: hidden;
    height: 1.2em;
    min-height: 1.2em;
  }
  .contact-modal-submit {
    display: flex;
    justify-content: flex-end;
    margin-top: 1em;
  }
  .contact-modal-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-size-button);
    font-weight: 500;
    font-family: inherit;
    height: var(--height-button);
    padding: 0 var(--padding-button-x);
    border-radius: 9999px;
    background: var(--color-secondary);
    color: var(--color-primary);
    border: none;
    cursor: pointer;
    transition: opacity 0.3s;
    min-width: 200px;
  }
  .contact-modal-send:hover {
    opacity: 0.6;
  }
  @media (max-width: 767px) {
    .contact-modal-field {
      grid-template-columns: 1fr;
      gap: 0.5em;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var modal = document.querySelector('.js-contact-modal');
    var openBtns = document.querySelectorAll('.js-open-contact');
    var closeBtns = document.querySelectorAll('.js-contact-close');

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    openBtns.forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });
    });

    closeBtns.forEach(function(btn) {
      btn.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      }
    });

    var form = document.getElementById('contact-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var fd = new FormData(form);
        var name = fd.get('name') || '';
        var email = fd.get('email') || '';
        var phone = fd.get('phone') || '';
        var message = fd.get('message') || '';
        var body = 'Name: ' + name + '%0D%0AEmail: ' + email + '%0D%0APhone: ' + phone + '%0D%0AMessage: ' + message;
        window.location.href = 'mailto:ivanrogovchenko@gmail.com?subject=Contact from Plusthreeeightzero&body=' + body;
      });
    }

    var textareas = document.querySelectorAll('.contact-modal-textarea');
    textareas.forEach(function(ta) {
      var lineHeight = parseFloat(getComputedStyle(ta).lineHeight) || parseFloat(getComputedStyle(ta).fontSize) * 1.2;
      ta.addEventListener('input', function() {
        ta.style.height = 'auto';
        var sh = ta.scrollHeight;
        if (sh <= lineHeight) {
          ta.style.height = lineHeight + 'px';
        } else {
          var maxH = Math.min(sh, window.innerHeight * 0.4);
          ta.style.height = maxH + 'px';
        }
      });
    });
  });
</script>
