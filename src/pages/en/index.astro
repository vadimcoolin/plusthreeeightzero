---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="PlusThreeEightZero" lang="en">
  <Header />
  <main>
    <section id="index" class="h-screen flex flex-col justify-end" style={`padding: 0 var(--spacing-page) var(--spacing-page)`}>
      <p class="font-normal mb-4" style={`font-size: var(--font-size-subtitle)`}>
        Strategic Brand Design Partner
      </p>
      <h1 class="uppercase leading-[0.95]" style={`font-size: var(--font-size-title)`}>
        <div class="font-extralight">We Build Brands</div>
        <div class="font-semibold"><img src={`${base}plus.svg`} class="inline-block h-[1cap] w-auto align-baseline" alt="" /> The Teams</div>
        <div class="font-semibold text-right">That Run Them</div>
      </h1>
      <a href="#contacts" class="inline-flex items-center justify-center border border-current font-medium w-fit rounded-full hover:bg-[var(--color-text)] hover:text-[var(--color-bg)] transition-colors mt-8" style={`font-size: var(--font-size-button); height: var(--height-button); padding: 0 var(--padding-button-x)`}>
        Contact Us
      </a>
    </section>
  </main>
</BaseLayout>
