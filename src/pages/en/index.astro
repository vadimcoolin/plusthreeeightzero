---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Showreel from '../../components/Showreel.astro';
import Services from '../../components/Services.astro';
import About from '../../components/About.astro';
import HoverTable from '../../components/HoverTable.astro';
import PartnerSection from '../../components/PartnerSection.astro';
import AboutCta from '../../components/AboutCta.astro';
import Works from '../../components/Works.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="PlusThreeEightZero" lang="en">
  <Header />
  <main>
    <section id="index" class="h-screen flex flex-col justify-center md:justify-end" style={`padding: var(--spacing-page)`}>
      <p class="font-normal mb-4" style={`font-size: var(--font-size-subtitle)`}>
        Strategic Brand Design Partner
      </p>
      <h1 class="uppercase leading-[0.95]" style={`font-size: var(--font-size-title)`}>
        <div class="font-extralight">We Build Brands</div>
        <div class="font-semibold"><svg class="inline-block h-[1cap] w-auto align-baseline" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M30 12.2919H17.7089V0H12.2919V12.2919H0V17.7089H12.2919V30H17.7089V17.7089H30V12.2919Z" fill="currentColor"/></svg> The Teams</div>
        <div class="font-semibold md:text-right">That Run Them</div>
      </h1>
      <a href="mailto:ivanrogovchenko@gmail.com" class="inline-flex items-center justify-center border border-current font-medium w-fit rounded-full hover:bg-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors mt-8" style={`font-size: var(--font-size-button); height: var(--height-button); padding: 0 var(--padding-button-x)`}>
        Contact Us
      </a>
    </section>
    <Showreel />
    <Services
      breadcrumbs={[
        { label: 'Index', href: '#index' },
        { label: 'Services' },
      ]}
      textFirst="Branding is effective only when strategy, identity, and communication work in sync."
      textSecond="Our services cover the full spectrum needed to make your company look coherent, credible, and ready to scale."
      services={[
        {
          title: 'Strategic Level',
          items: ['Business and market context analysis', 'Brand strategy grounded in business objectives', 'Identifying the real underlying need'],
          number: '(01)',
        },
        {
          title: 'Creative Level',
          items: ['Naming, identity, visual system', 'Communication design and brand messaging', 'Simplifying complex products into clear narratives'],
          number: '(02)',
        },
        {
          title: 'Operational Level',
          items: ['Team training', 'Onboarding and hiring support', 'Setting up brand operations and workflows', 'Ongoing support and updates'],
          number: '(03)',
        },
      ]}
      ctaText="Looking to align your brand and scale with confidence? Start the conversation today."
      ctaButtonText="Start Here"
    />
    <About
      breadcrumbs={[
        { label: 'Index', href: '#index' },
        { label: 'About' },
      ]}
      textFirst={`We don't show up to "make things pretty."`}
      textSecond="We embed into your team, bring clarity to complex ideas, and build the brand together with you — so that when we're done, you can move forward independently."
      stats={[
        { value: 'twenty five', label: 'years\u2019 experience' },
        { value: 'fourteen', label: 'industries served' },
        { value: 'six', label: 'global partnerships' },
        { value: 'twelve', label: 'completed projects' },
      ]}
    />
    <section class="w-full section-gap-before" style={`background-color: var(--color-secondary-bg)`}>
      <div class="grid grid-cols-1 md:grid-cols-4" style={`gap: var(--spacing-page)`}>
        <div class="md:col-span-1"></div>
        <div class="md:col-span-3">
          <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2); text-indent: 3em`}>
            <span style={`color: var(--color-muted)`}>Why Plus380? </span><span style={`color: var(--color-secondary)`}>A brand is not just a look — it's a capability. Here's what makes our partnership different.</span>
          </h2>
        </div>
      </div>
      <HoverTable rows={[
        { number: '+1', text: 'Hybrid experience: in-house background + founder mindset' },
        { number: '+2', text: 'Business-first approach: understanding of GTM, sales, and fundraising' },
        { number: '+3', text: 'Clarity for complex products: translating tech into simple narratives' },
        { number: '+4', text: 'Team enablement: your brand becomes operable, not a dependency' },
        { number: '+5', text: 'Results that matter: maturity for investors, clarity for clients, credibility for talent' }
      ]} />
    </section>
    <div style={`background-color: var(--color-secondary-bg)`}>
      <PartnerSection
        textLeft="We partner with early-stage and scaling tech teams who need a brand that supports sales, fundraising, and international growth."
        itemsRight={[
          'Pre-seed → Series A: first brand foundations',
          'Series A → B: rebranding for scale',
          'Founders and C-level actively involved in sales',
          'Complex products that require simplification',
          'EU-focused or US-bound companies from Eastern Europe'
        ]}
      />
      <AboutCta
        text="Need a design partner who strengthens both your brand and your team? Reach out and let's begin."
        buttonText="Build With Us"
      />
    </div>
    <Works projects={[
      {
        image: 'works/techiia/title_case01.webp',
        title: 'TECHIIA',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/109170771/Techiia-Brand-Identity'
      },
      {
        image: 'works/senseit/title_case02.webp',
        title: 'Sense It',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/116408711/Sense-it-Brand-Identity'
      },
      {
        image: 'works/esports/title_case03.webp',
        title: 'esports.ua',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/133354453/esportsua-identity'
      }
    ]} />
  </main>
  <Footer />
</BaseLayout>
