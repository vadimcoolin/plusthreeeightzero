---
const base = import.meta.env.BASE_URL;
---

<html>
  <head>
    <meta http-equiv="refresh" content={`0;url=${base}en/`} />
    <script>
      const base = import.meta.env.BASE_URL;
      const lang = navigator.language.startsWith('uk') ? 'ua' : 'en';
      window.location.href = base + lang + '/';
    </script>
  </head>
  <body></body>
</html>
