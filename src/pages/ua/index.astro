---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Showreel from '../../components/Showreel.astro';
import Services from '../../components/Services.astro';
import About from '../../components/About.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="PlusThreeEightZero" lang="uk">
  <Header />
  <main>
    <section id="index" class="h-screen flex flex-col justify-center md:justify-end" style={`padding: var(--spacing-page)`}>
      <p class="font-normal mb-4" style={`font-size: var(--font-size-subtitle)`}>
        Стратегічний бренд-дизайн партнер
      </p>
      <h1 class="uppercase leading-[0.95]" style={`font-size: var(--font-size-title)`}>
        <div class="font-extralight">Будуємо Бренди</div>
        <div class="font-semibold"><svg class="inline-block h-[1cap] w-auto align-baseline" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M30 12.2919H17.7089V0H12.2919V12.2919H0V17.7089H12.2919V30H17.7089V17.7089H30V12.2919Z" fill="currentColor"/></svg> Команди,</div>
        <div class="font-semibold md:text-right">Що Ними Керують</div>
      </h1>
      <a href="mailto:ivanrogovchenko@gmail.com" class="inline-flex items-center justify-center border border-current font-medium w-fit rounded-full hover:bg-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors mt-8" style={`font-size: var(--font-size-button); height: var(--height-button); padding: 0 var(--padding-button-x)`}>
        Напишіть нам
      </a>
    </section>
    <Showreel />
    <Services
      breadcrumbs={[
        { label: 'Головна', href: '#index' },
        { label: 'Послуги' },
      ]}
      textFirst="Брендинг ефективний лише тоді, коли стратегія, ідентичність та комунікація працюють синхронно."
      textSecond="Наші послуги охоплюють повний спектр, необхідний для того, щоб ваша компанія виглядала цілісно, впевнено та готова до масштабування."
      services={[
        {
          title: 'Стратегічний рівень',
          items: ['Аналіз бізнес- та ринкового контексту', 'Стратегія бренду, що ґрунтується на бізнес-цілях', 'Визначення справжньої основної потреби'],
          number: '(01)',
        },
        {
          title: 'Креативний рівень',
          items: ['Неймінг, айдентика, візуальна система', 'Дизайн комунікацій та меседжинг бренду', 'Спростення складних продуктів у зрозумілі наративи'],
          number: '(02)',
        },
        {
          title: 'Операційний рівень',
          items: ['Навчання команди', 'Підтримка онбордингу та найму', 'Налаштування операційних процесів бренду', 'Постійна підтримка та оновлення'],
          number: '(03)',
        },
      ]}
      ctaText="Хочете синхронізувати бренд та масштабуватися впевнено? Розпочніть розмову сьогодні."
      ctaButtonText="Почати"
    />
    <About
      breadcrumbs={[
        { label: 'Головна', href: '#index' },
        { label: 'Про нас' },
      ]}
      textFirst='Ми не приходимо, щоб «зробити красиво.»'
      textSecond="Ми інтегруємося у вашу команду, привносимо ясність у складні ідеї та будуємо бренд разом із вами — щоб, коли ми закінчимо, ви могли рухатися далі самостійно."
    />
  </main>
</BaseLayout>
