---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Showreel from '../../components/Showreel.astro';
import Services from '../../components/Services.astro';
import About from '../../components/About.astro';
import HoverTable from '../../components/HoverTable.astro';
import PartnerSection from '../../components/PartnerSection.astro';
import AboutCta from '../../components/AboutCta.astro';
import Works from '../../components/Works.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="PlusThreeEightZero" lang="uk">
  <Header />
  <main>
    <section id="index" class="h-screen flex flex-col justify-center md:justify-end" style={`padding: var(--spacing-page)`}>
      <p class="font-normal mb-4" style={`font-size: var(--font-size-subtitle)`}>
        Стратегічний бренд-дизайн партнер
      </p>
      <h1 class="uppercase leading-[0.95]" style={`font-size: var(--font-size-title)`}>
        <div class="font-extralight">Будуємо Бренди</div>
        <div class="font-semibold"><svg class="inline-block h-[1cap] w-auto align-baseline" width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M30 12.2919H17.7089V0H12.2919V12.2919H0V17.7089H12.2919V30H17.7089V17.7089H30V12.2919Z" fill="currentColor"/></svg> Команди,</div>
        <div class="font-semibold md:text-right">Що Ними Керують</div>
      </h1>
      <a href="mailto:ivanrogovchenko@gmail.com" class="inline-flex items-center justify-center border border-current font-medium w-fit rounded-full hover:bg-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors mt-8" style={`font-size: var(--font-size-button); height: var(--height-button); padding: 0 var(--padding-button-x)`}>
        Напишіть нам
      </a>
    </section>
    <Showreel />
    <Services
      breadcrumbs={[
        { label: 'Головна', href: '#index' },
        { label: 'Послуги' },
      ]}
      textFirst="Брендинг ефективний лише тоді, коли стратегія, ідентичність та комунікація працюють синхронно."
      textSecond="Наші послуги охоплюють повний спектр, необхідний для того, щоб ваша компанія виглядала цілісно, впевнено та готова до масштабування."
      services={[
        {
          title: 'Стратегічний рівень',
          items: ['Аналіз бізнес- та ринкового контексту', 'Стратегія бренду, що ґрунтується на бізнес-цілях', 'Визначення справжньої основної потреби'],
          number: '(01)',
        },
        {
          title: 'Креативний рівень',
          items: ['Неймінг, айдентика, візуальна система', 'Дизайн комунікацій та меседжинг бренду', 'Спростення складних продуктів у зрозумілі наративи'],
          number: '(02)',
        },
        {
          title: 'Операційний рівень',
          items: ['Навчання команди', 'Підтримка онбордингу та найму', 'Налаштування операційних процесів бренду', 'Постійна підтримка та оновлення'],
          number: '(03)',
        },
      ]}
      ctaText="Хочете синхронізувати бренд та масштабуватися впевнено? Розпочніть розмову сьогодні."
      ctaButtonText="Почати"
    />
    <About
      breadcrumbs={[
        { label: 'Головна', href: '#index' },
        { label: 'Про нас' },
      ]}
      textFirst="Ми не приходимо, щоб «зробити красиво.»"
      textSecond="Ми інтегруємося у вашу команду, привносимо ясність у складні ідеї та будуємо бренд разом із вами — щоб, коли ми закінчимо, ви могли рухатися далі самостійно."
      stats={[
        { value: "двадцять п'ять", label: 'років досвіду' },
        { value: 'чотирнадцять', label: 'галузей обслуговано' },
        { value: 'шість', label: 'глобальних партнерств' },
        { value: 'дванадцять', label: 'завершених проєктів' },
      ]}
    />
    <section class="w-full section-gap-before" style={`background-color: var(--color-secondary-bg)`}>
      <div class="grid grid-cols-1 md:grid-cols-4" style={`gap: var(--spacing-page)`}>
        <div class="md:col-span-1"></div>
        <div class="md:col-span-3">
          <h2 class="font-medium leading-[1.1]" style={`font-size: var(--font-size-h2); text-indent: 3em`}>
            <span style={`color: var(--color-muted)`}>Чому Plus380? </span><span style={`color: var(--color-secondary)`}>Бренд — це не просто зовнішній вигляд — це можливість. Ось що робить нашу співпрацю особливою.</span>
          </h2>
        </div>
      </div>
      <HoverTable rows={[
        { number: '+1', text: 'Гібридний досвід: внутрішній досвід + мислення засновника' },
        { number: '+2', text: 'Підхід, орієнтований на бізнес: розуміння GTM, продажів та залучення коштів' },
        { number: '+3', text: 'Ясність для складних продуктів: перетворення технологій на прості наративи' },
        { number: '+4', text: 'Посилення команди: ваш бренд стає робочим інструментом, а не залежністю' },
        { number: '+5', text: 'Результати, які мають значення: зрілість для інвесторів, ясність для клієнтів, довіра для талантів' }
      ]} />
    </section>
    <div style={`background-color: var(--color-secondary-bg)`}>
      <PartnerSection
        textLeft="Ми працюємо з командами на ранніх стадіях та в стадії масштабування, яким потрібен бренд, що підтримує продажі, залучення коштів та міжнародне зростання."
        itemsRight={[
          'Pre-seed → Series A: перші основи бренду',
          'Series A → B: ребрендинг для масштабування',
          'Засновники та C-level активно залучені до продажів',
          'Складні продукти, які потребують спрощення',
          'Компанії зі Східної Європи, орієнтовані на ЄС чи США'
        ]}
      />
      <AboutCta
        text="Потрібен дизайнер-партнер, який зміцнить ваш бренд і вашу команду? Зв'яжіться з нами, і почнемо."
        buttonText="Build With Us"
      />
    </div>
    <Works projects={[
      {
        image: 'works/techiia/title_case01.webp',
        title: 'TECHIIA',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/109170771/Techiia-Brand-Identity'
      },
      {
        image: 'works/senseit/title_case02.webp',
        title: 'Sense It',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/116408711/Sense-it-Brand-Identity'
      },
      {
        image: 'works/esports/title_case03.webp',
        title: 'esports.ua',
        tags: ['+Brand Strategy', '+Logo Design', '+Identity', '+Art Direction', '+Web Design'],
        link: 'https://www.behance.net/gallery/133354453/esportsua-identity'
      }
    ]} />
  </main>
  <Footer />
</BaseLayout>
